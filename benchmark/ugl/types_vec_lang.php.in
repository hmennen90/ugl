<?php
final class V { public function __construct(public float $x = 0.0) {} }
function f0($a) { return $a; }
function fi(int $a): int { return $a; }
function fi32(%I32% $a): %I32% { return $a; }
function ff(float $a): float { return $a; }
function ff32(%F32% $a): %F32% { return $a; }
function fv(V $a): V { return $a; }
class P { public int $i = 0; public %I32% $i32 = 0; public float $f = 0.0; public %F32% $f32 = 0.0; }

final readonly class UV3 {
	public function __construct(public float $x, public float $y, public float $z) {}
	public function add(UV3 $o): UV3 { return new UV3($this->x + $o->x, $this->y + $o->y, $this->z + $o->z); }
	public function mul(float $s): UV3 { return new UV3($this->x * $s, $this->y * $s, $this->z * $s); }
	public function dot(UV3 $o): float { return $this->x * $o->x + $this->y * $o->y + $this->z * $o->z; }
}
final readonly class UV2 {
	public function __construct(public float $x, public float $y) {}
	public function add(UV2 $o): UV2 { return new UV2($this->x + $o->x, $this->y + $o->y); }
}
enum E: int { case A = 1; case B = 2; case C = 3; }
const CA = 1;
function named(int $a, int $b = 0, int $c = 0) { return $a + $b + $c; }
function inc(int $x): int { return $x + 1; }
function dbl(int $x): int { return $x * 2; }

$N = 2_000_000; $x = 1.5; $v = new V(1.0); $p = new P; $e = E::B;
$G = $argv[1] ?? 'types'; $HAS = ($argv[2] ?? '0') === '1';
$g = [];
$g['types'] = [
 'untyped'          => function() use ($N,$x) { for ($i=0;$i<$N;$i++) f0($x); },
 'int p/r'          => function() use ($N) { for ($i=0;$i<$N;$i++) fi($i); },
 'int32 p/r'        => function() use ($N) { for ($i=0;$i<$N;$i++) fi32($i); },
 'float p/r'        => function() use ($N,$x) { for ($i=0;$i<$N;$i++) ff($x); },
 'float32 p/r'      => function() use ($N,$x) { for ($i=0;$i<$N;$i++) ff32($x); },
 'class V p/r'      => function() use ($N,$v) { for ($i=0;$i<$N;$i++) fv($v); },
 'prop int'         => function() use ($N,$p) { for ($i=0;$i<$N;$i++) $p->i = $i; },
 'prop int32'       => function() use ($N,$p) { for ($i=0;$i<$N;$i++) $p->i32 = $i; },
 'prop float'       => function() use ($N,$p,$x) { for ($i=0;$i<$N;$i++) $p->f = $x; },
 'prop float32'     => function() use ($N,$p,$x) { for ($i=0;$i<$N;$i++) $p->f32 = $x; },
];
$g['vec'] = [
 'user create'      => function() use ($N) { for ($i=0;$i<$N;$i++) $c = new UV3(1.0, 2.0, 3.0); },
 'user add'         => function() use ($N) { $a = new UV3(1.0,2.0,3.0); $b = new UV3(.5,.25,2.0); for ($i=0;$i<$N;$i++) $c = $a->add($b); },
 'user mul scalar'  => function() use ($N) { $a = new UV3(1.0,2.0,3.0); for ($i=0;$i<$N;$i++) $c = $a->mul(0.5); },
 'user dot'         => function() use ($N) { $a = new UV3(1.0,2.0,3.0); $b = new UV3(.5,.25,2.0); for ($i=0;$i<$N;$i++) $c = $a->dot($b); },
 'user particle'    => function() use ($N) { $p = new UV3(0.,0.,0.); $v = new UV3(1.,2.,3.); for ($i=0;$i<$N;$i++) $p = $p->add($v->mul(0.016)); },
 'user vec2 add'    => function() use ($N) { $a = new UV2(1.0,2.0); $b = new UV2(.5,.25); for ($i=0;$i<$N;$i++) $c = $a->add($b); },
 'array particle'   => function() use ($N) { $p = [0.,0.,0.]; $v = [1.,2.,3.]; for ($i=0;$i<$N;$i++) $p = [$p[0]+$v[0]*0.016, $p[1]+$v[1]*0.016, $p[2]+$v[2]*0.016]; },
 'floats particle'  => function() use ($N) { $px=$py=$pz=0.; $vx=1.;$vy=2.;$vz=3.; for ($i=0;$i<$N;$i++) { $px += $vx*0.016; $py += $vy*0.016; $pz += $vz*0.016; } },
];
if ($HAS) { $g['vec'] += [
 'core create'      => function() use ($N) { for ($i=0;$i<$N;$i++) $c = vec3(1, 2, 3); },
 'core add'         => function() use ($N) { $a = vec3(1,2,3); $b = vec3(.5,.25,2); for ($i=0;$i<$N;$i++) $c = $a + $b; },
 'core mul scalar'  => function() use ($N) { $a = vec3(1,2,3); for ($i=0;$i<$N;$i++) $c = $a * 0.5; },
 'core dot'         => function() use ($N) { $a = vec3(1,2,3); $b = vec3(.5,.25,2); for ($i=0;$i<$N;$i++) $c = $a->dot($b); },
 'core swizzle'     => function() use ($N) { $a = vec3(1,2,3); for ($i=0;$i<$N;$i++) $c = $a->zyx; },
 'core particle'    => function() use ($N) { $p = vec3(0,0,0); $v = vec3(1,2,3); for ($i=0;$i<$N;$i++) $p = $p + $v * 0.016; },
 'core vec2 add'    => function() use ($N) { $a = vec2(1,2); $b = vec2(.5,.25); for ($i=0;$i<$N;$i++) $c = $a + $b; },
]; }
$g['lang'] = [
 'if-chain'         => function() use ($N) { $s=0; for ($i=0;$i<$N;$i++) { $k=$i&3; if ($k===0) $s+=1; elseif ($k===1) $s+=2; elseif ($k===2) $s+=3; else $s+=4; } },
 'match'            => function() use ($N) { $s=0; for ($i=0;$i<$N;$i++) { $s += match($i&3) { 0=>1, 1=>2, 2=>3, default=>4 }; } },
 'int const cmp'    => function() use ($N) { $k=2; $s=0; for ($i=0;$i<$N;$i++) { if ($k === CA) $s++; } },
 'enum cmp'         => function() use ($N,$e) { $s=0; for ($i=0;$i<$N;$i++) { if ($e === E::A) $s++; } },
 'enum ->value'     => function() use ($N,$e) { $s=0; for ($i=0;$i<$N;$i++) { $s += $e->value; } },
 'positional args'  => function() use ($N) { for ($i=0;$i<$N;$i++) named($i, 2, 3); },
 'named args'       => function() use ($N) { for ($i=0;$i<$N;$i++) named(a: $i, b: 2, c: 3); },
 'nested calls'     => function() use ($N) { for ($i=0;$i<$N;$i++) $r = dbl(inc(dbl($i))); },
 'pipe |>'          => function() use ($N) { for ($i=0;$i<$N;$i++) $r = $i |> dbl(...) |> inc(...) |> dbl(...); },
 'fixed array rw'   => function() use ($N) { $a = array_fill(0, 16, 0.0); for ($i=0;$i<$N;$i++) { $a[$i & 15] = $a[($i+1) & 15] + 1.0; } },
 'readonly new'     => function() use ($N) { for ($i=0;$i<$N;$i++) $c = new UV2(1.0, 2.0); },
 'array literal'    => function() use ($N) { for ($i=0;$i<$N;$i++) $c = [1.0, 2.0]; },
 'closure call'     => function() use ($N) { $f = fn($x) => $x + 1; for ($i=0;$i<$N;$i++) $r = $f($i); },
 'function call'    => function() use ($N) { for ($i=0;$i<$N;$i++) $r = inc($i); },
];
$out = [];
foreach ($g[$G] as $k => $f) { $b = PHP_FLOAT_MAX; for ($r=0;$r<3;$r++) { $t = hrtime(true); $f(); $b = min($b, (hrtime(true)-$t)/1e6); } $out[$k] = round($b, 2); }
echo json_encode($out), "\n";
